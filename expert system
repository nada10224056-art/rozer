<style>
  :root{
    --bg: #142B1C;
    --bg-deep: #0E2015;
    --surface: #FBF7EC;
    --surface-alt: #F1E9D2;
    --ink: #1B2B1E;
    --muted: #5C6B5D;
    --leaf: #5B8C3E;
    --leaf-dark: #3B5E28;
    --leaf-pale: #DCE9CE;
    --gold: #D4A017;
    --gold-dark: #A87B0E;
    --rust: #A6432B;
    --line: rgba(27,43,30,0.14);
    --radius: 14px;
    --shadow: 0 10px 30px rgba(14,32,21,0.18);
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background: var(--bg);
    background-image:
      radial-gradient(ellipse at 20% -10%, rgba(91,140,62,0.35), transparent 55%),
      radial-gradient(ellipse at 100% 0%, rgba(212,160,23,0.12), transparent 45%);
    color: var(--ink);
    font-family: 'Public Sans', sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  h1,h2,h3,.display{
    font-family: 'Fraunces', serif;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .mono{ font-family:'JetBrains Mono', monospace; }
  .wrap{ max-width: 900px; margin: 0 auto; padding: 0 20px 120px; }

  /* ---------- HERO ---------- */
  .hero{
    padding: 56px 20px 40px;
    text-align:center;
    color: var(--leaf-pale);
    position:relative;
  }
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono', monospace;
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--gold);
    background: rgba(212,160,23,0.12);
    border: 1px solid rgba(212,160,23,0.35);
    padding: 6px 14px;
    border-radius: 999px;
    margin-bottom: 22px;
  }
  .eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--gold);}
  .hero h1{
    font-size: clamp(34px, 6vw, 54px);
    color: #FBF7EC;
    margin: 0 0 12px;
    line-height: 1.05;
  }
  .hero h1 em{ color: var(--gold); font-style: normal; }
  .hero p{
    max-width: 540px; margin: 0 auto;
    color: rgba(251,247,236,0.72);
    font-size: 16px; line-height: 1.6;
  }
  .stalk{ width: 180px; height: auto; margin: 28px auto 6px; display:block; }

  .stat-row{
    display:flex; justify-content:center; gap: 28px;
    margin-top: 34px; flex-wrap: wrap;
  }
  .stat{ text-align:left; }
  .stat b{
    display:block; font-family:'Fraunces',serif; font-size: 26px; color:#FBF7EC;
  }
  .stat span{ font-size: 12px; color: rgba(251,247,236,0.55); text-transform:uppercase; letter-spacing:0.06em; }

  /* ---------- PANEL ---------- */
  .panel{
    background: var(--surface);
    border-radius: 22px;
    box-shadow: var(--shadow);
    padding: 34px clamp(18px, 4vw, 40px) 30px;
    margin-top: 10px;
  }
  .panel-head{ margin-bottom: 22px; }
  .panel-head .kicker{
    font-family:'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--leaf-dark); font-weight:700;
  }
  .panel-head h2{ font-size: 24px; margin: 6px 0 6px; color: var(--ink); }
  .panel-head p{ color: var(--muted); font-size: 14.5px; line-height:1.6; margin:0; }

  /* symptom groups */
  .group{ margin-bottom: 22px; }
  .group-title{
    display:flex; align-items:center; gap:10px;
    font-size: 13px; font-weight:700; text-transform:uppercase; letter-spacing:0.04em;
    color: var(--leaf-dark);
    margin-bottom: 12px;
  }
  .group-title .idx{
    width:22px;height:22px; border-radius:50%; background:var(--leaf-dark); color:#fff;
    display:flex; align-items:center; justify-content:center; font-size:11px; font-family:'JetBrains Mono',monospace;
  }
  .chips{ display:grid; grid-template-columns: repeat(auto-fill, minmax(260px,1fr)); gap:10px; }
  .chip{
    position:relative;
    border: 1.5px solid var(--line);
    background: #fff;
    border-radius: 12px;
    padding: 12px 14px 12px 42px;
    font-size: 13.5px; line-height:1.45;
    cursor:pointer;
    transition: border-color .15s, background .15s, transform .1s;
    user-select:none;
  }
  .chip:hover{ border-color: var(--leaf); }
  .chip input{ position:absolute; opacity:0; }
  .chip .box{
    position:absolute; left:12px; top:12px;
    width:18px; height:18px; border-radius:5px;
    border: 1.5px solid #B9C3B4;
    background:#fff;
    display:flex; align-items:center; justify-content:center;
  }
  .chip .box svg{ width:12px; height:12px; opacity:0; transform: scale(0.6); transition: all .12s; }
  .chip input:checked ~ .box{ background: var(--leaf); border-color: var(--leaf); }
  .chip input:checked ~ .box svg{ opacity:1; transform: scale(1); }
  .chip:has(input:checked){ background: var(--leaf-pale); border-color: var(--leaf); }

  /* action bar */
  .action-bar{
    position: sticky; bottom: 16px;
    display:flex; gap:10px; align-items:center; justify-content:space-between;
    background: var(--bg-deep);
    border-radius: 16px;
    padding: 12px 16px;
    margin-top: 26px;
    box-shadow: 0 12px 26px rgba(14,32,21,0.35);
  }
  .action-bar .count{ color: rgba(251,247,236,0.75); font-size:13px; font-family:'JetBrains Mono',monospace; }
  .action-bar .count b{ color:#fff; }
  .btns{ display:flex; gap:8px; }
  button{ font-family:'Public Sans',sans-serif; border:none; cursor:pointer; border-radius:10px; }
  .btn-primary{
    background: var(--gold); color: #2A1D02; font-weight:700; font-size:14px;
    padding: 12px 22px;
    transition: transform .1s, background .15s;
  }
  .btn-primary:hover{ background:#E4B12B; }
  .btn-primary:active{ transform: scale(0.98); }
  .btn-ghost{
    background: transparent; color: rgba(251,247,236,0.6); font-size:13px;
    padding: 12px 14px; border:1px solid rgba(251,247,236,0.2);
  }
  .btn-ghost:hover{ color:#fff; border-color:rgba(251,247,236,0.4); }

  /* ---------- RESULTS ---------- */
  .results{ margin-top: 34px; display:none; }
  .results.show{ display:block; }
  .results-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:16px; flex-wrap:wrap; gap:8px;}
  .results-head h2{ color:#FBF7EC; font-size:22px; margin:0; }
  .results-head span{ color: rgba(251,247,236,0.55); font-size:12.5px; font-family:'JetBrains Mono',monospace; }

  .card{
    background: var(--surface);
    border-radius: 16px;
    padding: 22px 22px 20px;
    margin-bottom: 16px;
    position: relative;
    border: 1px dashed rgba(27,43,30,0.25);
    box-shadow: var(--shadow);
  }
  .card.top{ border: 1.5px solid var(--gold); background: linear-gradient(180deg, #FFFDF6, var(--surface) 40%); }
  .stamp{
    position:absolute; top:18px; right:18px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    width:64px; height:64px; border-radius:50%;
    border: 2px solid currentColor;
    transform: rotate(8deg);
    font-family:'JetBrains Mono',monospace;
  }
  .stamp b{ font-size:16px; line-height:1; }
  .stamp span{ font-size:8px; text-transform:uppercase; letter-spacing:0.05em; }
  .conf-high{ color: var(--leaf-dark); }
  .conf-mid{ color: var(--gold-dark); }
  .conf-low{ color: var(--rust); }

  .card-eyebrow{ font-family:'JetBrains Mono',monospace; font-size:10.5px; letter-spacing:0.1em; text-transform:uppercase; color:var(--muted); margin-bottom:4px;}
  .card h3{ font-size: 20px; margin: 0 6px 2px 0; max-width: 74%; }
  .card .latin{ font-style: italic; color: var(--muted); font-size: 13px; margin-bottom: 14px; }

  .matched{ display:flex; flex-wrap:wrap; gap:6px; margin-bottom:16px; }
  .matched span{
    font-size:11.5px; background: var(--leaf-pale); color:var(--leaf-dark);
    padding:4px 9px; border-radius:999px; font-weight:600;
  }

  .bar-track{ height:7px; border-radius:999px; background:var(--surface-alt); overflow:hidden; margin-bottom:16px;}
  .bar-fill{ height:100%; border-radius:999px; background: linear-gradient(90deg, var(--leaf), var(--gold)); }

  .rec{ margin-top: 6px; }
  .rec h4{ font-size:12.5px; text-transform:uppercase; letter-spacing:0.06em; color: var(--leaf-dark); margin:14px 0 8px; }
  .rec ol, .rec ul{ margin:0; padding-left: 20px; font-size:13.5px; line-height:1.65; color: var(--ink); }
  .rec li{ margin-bottom: 4px; }

  .empty{
    text-align:center; padding: 30px 10px; color: rgba(251,247,236,0.6); font-size:14px;
  }

  .disclaimer{
    margin-top: 26px; font-size:12px; line-height:1.6; color: rgba(251,247,236,0.55);
    border-top: 1px solid rgba(251,247,236,0.14); padding-top:16px;
  }

  footer{ text-align:center; padding: 30px 20px 10px; color: rgba(251,247,236,0.4); font-size:12px; }

  @media (max-width:560px){
    .chips{ grid-template-columns: 1fr; }
    .action-bar{ flex-direction:column; align-items:stretch; }
    .btns{ justify-content:space-between; }
    .card h3{ max-width: 66%; }
  }

  @media (prefers-reduced-motion: reduce){
    *{ transition: none !important; }
  }
</style>
</head>
