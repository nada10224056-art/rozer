/* ---------------------------------------------------------
   RENDER SYMPTOM CHECKLIST
--------------------------------------------------------- */
const groupsEl = document.getElementById('groups');
SYMPTOM_GROUPS.forEach((g, gi)=>{
  const wrap = document.createElement('div');
  wrap.className = 'group';
  wrap.innerHTML = `<div class="group-title"><span class="idx">${gi+1}</span>${g.title}</div>
    <div class="chips">
      ${g.items.map(([id,label])=>`
        <label class="chip">
          <input type="checkbox" value="${id}">
          <span class="box"><svg viewBox="0 0 16 16" fill="none"><path d="M3 8l3.5 3.5L13 4.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          ${label}
        </label>`).join('')}
    </div>`;
  groupsEl.appendChild(wrap);
});

const checkboxes = () => Array.from(document.querySelectorAll('#groups input[type=checkbox]'));
const countNum = document.getElementById('countNum');

function updateCount(){
  const n = checkboxes().filter(c=>c.checked).length;
  countNum.textContent = n;
}
groupsEl.addEventListener('change', updateCount);

document.getElementById('resetBtn').addEventListener('click', ()=>{
  checkboxes().forEach(c=>c.checked=false);
  updateCount();
  document.getElementById('results').classList.remove('show');
});

/* ---------------------------------------------------------
   INFERENCE ENGINE
--------------------------------------------------------- */
document.getElementById('diagBtn').addEventListener('click', ()=>{
  const selected = new Set(checkboxes().filter(c=>c.checked).map(c=>c.value));
  const resultsEl = document.getElementById('results');
  const cardsEl = document.getElementById('cards');
  const metaEl = document.getElementById('resultMeta');
  cardsEl.innerHTML = '';

  if(selected.size === 0){
    cardsEl.innerHTML = `<div class="card"><div class="empty">Pilih minimal satu gejala terlebih dahulu untuk memulai diagnosa.</div></div>`;
    resultsEl.classList.add('show');
    metaEl.textContent = '';
    resultsEl.scrollIntoView({behavior:'smooth', block:'start'});
    return;
  }

  // Score each disease: sum of matched weights / total weights of that disease
  const scored = DISEASES.map(d=>{
    const entries = Object.entries(d.symptoms);
    const totalWeight = entries.reduce((s,[,w])=>s+w,0);
    let matchedWeight = 0;
    const matchedLabels = [];
    entries.forEach(([sym,w])=>{
      if(selected.has(sym)){ matchedWeight += w; matchedLabels.push(LABELS[sym]); }
    });
    const confidence = totalWeight ? matchedWeight/totalWeight : 0;
    return { ...d, confidence, matchedLabels, matchedCount: matchedLabels.length };
  })
  .filter(d => d.matchedCount > 0)
  .sort((a,b)=> b.confidence - a.confidence || b.matchedCount - a.matchedCount);

  const shown = scored.filter(d=>d.confidence >= 0.25).slice(0,4);
  const finalList = shown.length ? shown : scored.slice(0,1);

  if(finalList.length === 0){
    cardsEl.innerHTML = `<div class="card"><div class="empty">Gejala yang dipilih belum cukup cocok dengan pola hama/penyakit dalam basis pengetahuan. Coba tambahkan gejala lain yang teramati, atau konsultasikan langsung ke PPL setempat.</div></div>`;
    resultsEl.classList.add('show');
    metaEl.textContent = '';
    resultsEl.scrollIntoView({behavior:'smooth', block:'start'});
    return;
  }

  metaEl.textContent = `${selected.size} gejala dianalisis · ${finalList.length} kemungkinan ditemukan`;

  finalList.forEach((d, i)=>{
    const pct = Math.round(d.confidence*100);
    const confClass = pct>=70 ? 'conf-high' : pct>=45 ? 'conf-mid' : 'conf-low';
    const card = document.createElement('div');
    card.className = 'card' + (i===0 ? ' top' : '');
    card.innerHTML = `
      <div class="stamp ${confClass}"><b>${pct}%</b><span>cocok</span></div>
      <div class="card-eyebrow">${i===0?'Diagnosa Utama':'Kemungkinan Lain'} · ${d.type}</div>
      <h3>${d.name}</h3>
      <div class="latin">${d.latin}</div>
      <div class="bar-track"><div class="bar-fill" style="width:${pct}%"></div></div>
      <div class="matched">${d.matchedLabels.map(l=>`<span>${l}</span>`).join('')}</div>
      <div class="rec">
        <h4>Rekomendasi Penanganan</h4>
        <ol>${d.treatment.map(t=>`<li>${t}</li>`).join('')}</ol>
        <h4>Pencegahan Musim Berikutnya</h4>
        <ul>${d.prevention.map(t=>`<li>${t}</li>`).join('')}</ul>
      </div>
    `;
    cardsEl.appendChild(card);
  });

  resultsEl.classList.add('show');
  resultsEl.scrollIntoView({behavior:'smooth', block:'start'});
});
</script>
